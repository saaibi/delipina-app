{
  "name": "delipina",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node --env-file=.env server/index.js",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "migrate": "node --env-file=.env server/migrate.js",
    "seed": "node --env-file=.env server/seed.js",
    "test": "node --env-file=.env --test tests/*.test.js",
    "db:local": "pglite-server --db=../work/pglite --port=55432",
    "bootstrap": "node server/bootstrap.js"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "cookie-parser": "latest",
    "express": "latest",
    "google-auth-library": "latest",
    "helmet": "latest",
    "idb": "latest",
    "pg": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "latest",
    "socket.io-client": "latest",
    "web-push": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "prettier": "^3.10.1",
    "supertest": "latest",
    "vite": "8.3.8"
  }
}
