{
  "name": "delipina",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node --import tsx scripts/local-preview.ts",
    "preview:maps": "vite client --host 127.0.0.1 --port 3007 --strictPort",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json && tsc -p tsconfig.sw.json && vite build client --outDir ../dist --emptyOutDir",
    "start": "node dist-server/index.js",
    "migrate": "node --env-file=.env --import tsx server/migrate.ts",
    "seed": "node --env-file=.env --import tsx server/seed.ts",
    "test": "npm run build:server && node --env-file=.env --import tsx --test tests/*.test.ts",
    "bootstrap": "node dist-server/bootstrap.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json",
    "build:server": "tsc -p tsconfig.server.json",
    "test:local": "node --import tsx scripts/test-local.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.6.2",
    "@capacitor/push-notifications": "8.1.3",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/x-date-pickers": "9.18.0",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.23",
    "express": "5.3.0",
    "google-auth-library": "11.3.4",
    "helmet": "8.3.0",
    "idb": "8.0.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
